[Unit]
Description=Ambient-light keyboard backlight (omarchy-kbd-backlight)
Documentation=file://%h/.local/bin/omarchy-kbd-backlight
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/omarchy-kbd-backlight daemon
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=graphical-session.target
